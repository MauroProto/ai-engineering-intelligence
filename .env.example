# No escribir claves reales aqui. DEEPSEEK_API_KEY llega solo al entorno del proceso.
LLM_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
EMBEDDING_MODEL=all-MiniLM-L6-v2
REDIS_URL=redis://127.0.0.1:6389/0
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=coderhouse-intelligence
DATA_DIR=.data
WORKER_CONCURRENCY=5
MAX_AGENT_STEPS=8
TASK_TIMEOUT_SECONDS=600
MODEL_TIMEOUT_SECONDS=120
# Tarifas Flash OFF-PEAK verificadas 26/09/2026. Ajustar al cambiar horario/precios.
INPUT_PRICE_PER_MILLION=0.15
CACHED_INPUT_PRICE_PER_MILLION=0.003
OUTPUT_PRICE_PER_MILLION=0.60
